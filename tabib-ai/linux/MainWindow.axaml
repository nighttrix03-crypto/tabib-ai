<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TabibAI.Linux"
        xmlns:chat="using:TabibAI.Linux.Ui.Chat"
        xmlns:i18n="using:TabibAI.Linux.Core.I18n"
        xmlns:models="using:TabibAI.Linux.Core.Models"
        x:Class="TabibAI.Linux.MainWindow"
        x:DataType="vm:AppViewModel"
        Title="{i18n:Loc AppTitle}"
        Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        FlowDirection="RightToLeft"
        Background="{StaticResource BackgroundBrush}">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="Padding" Value="20 12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0 0 0 1" Padding="16 12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="ط" Foreground="{StaticResource TextOnPrimaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{i18n:Loc AppTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="مساعد طبي ذكي يعمل 100% محلياً" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AvailableCultures}" SelectedItem="{Binding CurrentCulture}" Width="120" Margin="0 0 8 0"
                              DisplayMemberBinding="{Binding DisplayName}" ToolTip.Tip="{i18n:Loc Language}"/>
                    <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" Width="120"
                              DisplayMemberBinding="{Binding DisplayName}" ToolTip.Tip="{i18n:Loc Theme}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl>
            <!-- Chat Tab -->
            <TabItem Header="{i18n:Loc ChatTab}">
                <chat:ChatView DataContext="{Binding ChatViewModel}" />
            </TabItem>

            <!-- Cases History Tab -->
            <TabItem Header="{i18n:Loc CasesTab}">
                <Border Background="{StaticResource SurfaceBrush}" Margin="16" CornerRadius="12" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="السجل الطبي" FontSize="18" FontWeight="Bold" Margin="0 0 0 16" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ListBox ItemsSource="{Binding ChatViewModel.Cases}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:MedicalCase">
                                    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0 4">
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding ChiefComplaint}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DifferentialDiagnosis[0].Condition, FallbackValue='—'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 8 0 0">
                                                <Button Content="فتح" Command="{Binding ((vm:AppViewModel)DataContext).ChatViewModel.LoadCaseCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" CommandParameter="{Binding}" Padding="12 6" FontSize="12"/>
                                                <Button Content="تقرير" Command="{Binding ((vm:AppViewModel)DataContext).ChatViewModel.GenerateReportCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" CommandParameter="{Binding}" Padding="12 6" FontSize="12" Classes="Secondary"/>
                                                <Button Content="حذف" Command="{Binding ((vm:AppViewModel)DataContext).ChatViewModel.DeleteCaseCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}" CommandParameter="{Binding}" Padding="12 6" FontSize="12" Classes="Danger"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="{i18n:Loc SettingsTab}">
                <ScrollViewer Background="{StaticResource SurfaceBrush}" Margin="16" Padding="24">
                    <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Center">
                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{i18n:Loc Language}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableCultures}" SelectedItem="{Binding CurrentCulture}" DisplayMemberBinding="{Binding DisplayName}" FontSize="14" Padding="12 8" CornerRadius="8"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{i18n:Loc Theme}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberBinding="{Binding DisplayName}" FontSize="14" Padding="12 8" CornerRadius="8"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{i18n:Loc Model}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModelOption}" DisplayMemberBinding="{Binding DisplayName}" FontSize="14" Padding="12 8" CornerRadius="8"/>
                                <Button Content="{i18n:Loc DownloadModel}" Command="{Binding DownloadModelCommand}" Padding="16 10" HorizontalAlignment="Left" IsEnabled="{Binding !IsModelDownloading}"/>
                                <ProgressBar IsVisible="{Binding IsModelDownloading}" Value="{Binding ModelDownloadProgress}" Height="8" Margin="0 8 0 0"/>
                                <TextBlock Text="{Binding ModelStatus}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="معلومات النظام" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SystemInfo}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{i18n:Loc Disclaimer}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0 24 0 0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
